# Copy this file to `.env.local` for local development. Never commit `.env.local`.
# Both variables are `NEXT_PUBLIC_*`, so they are inlined at BUILD time:
# after changing one in Vercel -> Settings -> Environment Variables, trigger a Redeploy.

# Debora's Calendly event links. Both have working defaults in lib/site.ts
# (1:1 -> https://calendly.com/learnalb/new-meeting, group -> https://calendly.com/learnalb/learn-albanian);
# set these only to point the "Reserve your spot" section at different events.
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_CALENDLY_GROUP_URL=

# Optional override for the canonical origin (canonical URL, Open Graph tags, JSON-LD, sitemap).
# Defaults to https://www.learnalbanianwithdebora.com on Vercel and http://localhost:3000 locally,
# so only set this if the domain ever changes.
NEXT_PUBLIC_SITE_URL=
