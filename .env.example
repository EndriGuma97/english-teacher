# Copy this file to `.env.local` for local development. Never commit `.env.local`.
# Both variables are `NEXT_PUBLIC_*`, so they are inlined at BUILD time:
# after changing one in Vercel -> Settings -> Environment Variables, trigger a Redeploy.

# Debora's Calendly event link (e.g. https://calendly.com/debora/albanian-lesson).
# Leave empty to show the "Booking calendar coming soon" placeholder.
# Set it to activate the real inline booking widget in the "Reserve your spot" section.
NEXT_PUBLIC_CALENDLY_URL=

# The final public URL of the site (e.g. https://www.example.com), used for the canonical URL,
# Open Graph tags and the sitemap. Until it is set, the code falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL (and to http://localhost:3000 locally).
NEXT_PUBLIC_SITE_URL=
